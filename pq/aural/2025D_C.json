ng": "1971: nineteen seventy-one", "ctx": "Gives the year the festival began."}, {"lit": "is", "meaning": "is: is, copula", "ctx": "Starts an identification sentence about the aim."}, {"lit": "it", "meaning": "é: it, him", "ctx": "Links the aim with what follows."}, {"lit": "aim", "meaning": "aidhm: aim, purpose", "ctx": "States the purpose of the competition."}, {"lit": "of the", "meaning": "an: the", "ctx": "Marks comórtais as definite in the genitive."}, {"lit": "competition", "meaning": "comórtas: competition (genitive: chomórtais)", "ctx": "Means of the competition."}, {"lit": "national", "meaning": "náisiúnta: national", "ctx": "Describes the competition in the genitive phrase."}, {"lit": "this", "meaning": "seo: this", "ctx": "Points to this national competition."}, {"lit": "that is", "meaning": "ná: that is, namely", "ctx": "Introduces the aim itself."}, {"lit": "song", "meaning": "amhrán: song", "ctx": "The item to be found."}, {"lit": "new", "meaning": "nua: new", "ctx": "Describes the song."}, {"lit": "to", "meaning": "a: to, relative particle", "ctx": "Links amhrán with aimsiú: a song to find."}, {"lit": "find", "meaning": "aimsigh: to find (verbal noun: aimsiú)", "ctx": "The aim is to find a new song."}, {"lit": "to", "meaning": "le: to, for", "ctx": "Introduces the purpose, to be in competition."}, {"lit": "be", "meaning": "bí: to be (verbal noun: bheith)", "ctx": "Part of le bheith, to be."}, {"lit": "in the", "meaning": "i + an: in the (combined form: san)", "ctx": "Part of san iomaíocht, in the competition."}, {"lit": "competition", "meaning": "iomaíocht: competition, contest", "ctx": "Shows the song will be in competition."}, {"lit": "on", "meaning": "ar: on, for", "ctx": "Part of ar son, on behalf of."}, {"lit": "behalf", "meaning": "son: behalf, sake", "ctx": "Completes ar son, for."}, {"lit": "of", "meaning": "an: the (genitive feminine singular: na)", "ctx": "Marks Éireann in the genitive."}, {"lit": "Ireland", "meaning": "Éire: Ireland (geniti