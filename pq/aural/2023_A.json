ning": "ar: on", "ctx": "Here means about, as in experience of life."}, {"lit": "the", "meaning": "an: the", "ctx": "Introduces saol."}, {"lit": "life", "meaning": "saol: life, world", "ctx": "Refers to life at university."}, {"lit": "in the", "meaning": "i: in, sa: in the (san before vowel)", "ctx": "Says where that life is."}, {"lit": "university", "meaning": "ollscoil: university", "ctx": "The setting of student life."}, {"lit": "with", "meaning": "le: with (with an: leis na)", "ctx": "Shows who they share it with."}, {"lit": "the", "meaning": "an: the (plural: na)", "ctx": "Introduces scoláirí."}, {"lit": "students", "meaning": "scoláire: school student (plural: scoláirí)", "ctx": "The people the experience is shared with."}, {"lit": "as", "meaning": "chomh: as, so", "ctx": "Part of chomh maith le, as well as."}, {"lit": "good", "meaning": "maith: good, well", "ctx": "Part of chomh maith le, as well as."}, {"lit": "with", "meaning": "le: with", "ctx": "Completes chomh maith le, as well as."}, {"lit": "information", "meaning": "eolas: knowledge, information (with h-prefix: heolas)", "ctx": "Another thing shared with the school students."}, {"lit": "on", "meaning": "ar: on, about", "ctx": "Introduces the topic of societies."}, {"lit": "the", "meaning": "an: the (plural: na)", "ctx": "Introduces cumainn."}, {"lit": "societies", "meaning": "cumann: society, club (plural: cumainn)", "ctx": "Refers to university societies."}, {"lit": "to", "meaning": "go: to, until", "ctx": "Part of go léir, all."}, {"lit": "all", "meaning": "léir: clear, entire", "ctx": "Completes go léir, all."}, {"lit": "that are", "meaning": "atá: that is, that are", "ctx": "Introduces a relative clause about the societies."}, {"lit": "in the", "meaning": "i: in, sa: in the (san before vowel)", "ctx": "Says where the societies are."}, {"lit": "university", "meaning": "ollscoil: university", "ctx": "The place where all the societies are."}]}