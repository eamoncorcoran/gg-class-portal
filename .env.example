NODE_ENV=development
PORT=3000
# The address students type in. In production this must be https:// or the
# session cookie, which is marked Secure, will never come back.
APP_URL=http://localhost:3000
# Server only. The domain Caddy gets the certificate for. Same host as APP_URL.
APP_DOMAIN=
# Server only. The database password inside the Docker network.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gaeilgeoir_support
DATABASE_SSL=false
SESSION_COOKIE_NAME=gg_session
SESSION_DAYS=90
APP_ENCRYPTION_KEY=replace_with_64_hex_characters
# Claude writes the check-in, homework and board drafts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# OpenAI is dictation and transcription only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Bunny Stream holds the class recordings. The library key uploads; the token
# key signs playback so a forwarded link stops working. Without the token key
# playback still works, but a copied link keeps working too.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_TOKEN_KEY=
BUNNY_TOKEN_HOURS=6

# A Zoom Server-to-Server OAuth app, read scopes only. It lists recordings and
# downloads them, and is never given permission to delete anything.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# The secret for the recording.completed webhook. Without it every webhook
# request is refused rather than accepted unverified.
ZOOM_WEBHOOK_SECRET=
# The safety-net sweep for recordings the webhook did not deliver.
ZOOM_SWEEP_CRON=20 * * * *
UPLOAD_DIR=./uploads
# Student work and voice notes. Never served publicly.
PRIVATE_UPLOAD_DIR=./uploads-private
MAX_UPLOAD_MB=20
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=Gaeilgeoir Guides
EMAIL_FROM_ADDRESS=support@gaeilgeoirguides.com
EMAIL_REPLY_TO=support@gaeilgeoirguides.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
GHL_EMAIL_WEBHOOK_URL=
REMINDER_CRON=*/5 * * * *
# Nightly backup. On by default in production. Copy the files off the server.
BACKUP_ENABLED=true
BACKUP_CRON=15 3 * * *
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
DEFAULT_TIMEZONE=Europe/Dublin

# The nightly backup, emailed to somebody. Needs no account beyond the mail
# already configured above.
BACKUP_EMAIL_TO=

# Off-site backup. Any S3-compatible storage — Backblaze B2, Cloudflare R2, AWS.
# Without these the nightly backup stays on the server disk only, which does not
# survive losing the disk.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=
