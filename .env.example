NODE_ENV=development
PORT=3000
# The address students type in. In production this must be https:// or the
# session cookie, which is marked Secure, will never come back.
APP_URL=http://localhost:3000
# Server only. The domain Caddy gets the certificate for. Same host as APP_URL.
APP_DOMAIN=
# Server only. The database password inside the Docker network.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gaeilgeoir_support
DATABASE_SSL=false
SESSION_COOKIE_NAME=gg_session
SESSION_DAYS=90
APP_ENCRYPTION_KEY=replace_with_64_hex_characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
UPLOAD_DIR=./uploads
# Student work and voice notes. Never served publicly.
PRIVATE_UPLOAD_DIR=./uploads-private
MAX_UPLOAD_MB=20
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=Gaeilgeoir Guides
EMAIL_FROM_ADDRESS=support@gaeilgeoirguides.com
EMAIL_REPLY_TO=support@gaeilgeoirguides.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
GHL_EMAIL_WEBHOOK_URL=
REMINDER_CRON=*/5 * * * *
# Nightly backup. On by default in production. Copy the files off the server.
BACKUP_ENABLED=true
BACKUP_CRON=15 3 * * *
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
DEFAULT_TIMEZONE=Europe/Dublin
